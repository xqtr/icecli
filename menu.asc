prog Terminal null bash
prog Installer null xpi
prog Files null mc
separator
menu "Office" null {
  prog "MarkDown Editor" null markln
  prog "Text Editor" null micro
  prog "Spreadsheet" null termcell
  prog "Calendar" null calcurse
  prog Cointop null cointop
}
menu "Network" gnome-globe.png {
  prog "Wifi Networks" null wifitui
  prog Links null links
  prog Lynx null lynx
  prog "RSS Feeds" null "feedln.sh"
  prog "CopyParty File Server" null copyparty
  prog "Manage Hotspot" null "sudo /home/x/bin/xqhotspot.sh"
}
menu "Hacking" null {
  prog Angryoxide null "sudo angryoxide"
  prog Airgeddon null "sudo airgeddon"
  prog Wifite null "sudo wifite"
}
menu "Media" null {
  prog mocp null mocp
  prog "IPTV" null termv
  prog "Podcasts" null castero
  prog "Paint" null "texual-paint"
  prog "Play Anime" null "ani-cli"
  prog "Play Movies | lobster" null "lobster"
  prog "Play Movies | luffy" null "luffy"
  prog Clidrop null clidrop
  prog "EXIF Remover" null xqexif.sh
}
menu "Development" gnome-devel.png {
  prog Calculator null calculus
  prog micro null micro
  prog Harlequin null harlequin
  prog "ASCII Chars." null "asciitable"
}
menu "HAM Radio" null {
  prog Chirpshell null "chirpshell"
  prog Heatwave null "heatwave"
  prog PySpecSDR null "pyspecsdr"
  prog dump1090 null "dump1090 --interactive"
  prog JS8Call null "js8call"
  prog "SW Radios Playing Now" null "xqshortwaveradio.sh"
  prog "Poor Mans RTL Software" null xqpmrtl.sh
  prog "Check Frequency" null xqfrequency.py

}
separator
menu "System" null {
  prog "Task Manager" null htop
  prog "Task Manager2" null btop
  prog "Audio Mixer" null alsamixer
  prog "Disk Usage" null "ncdu ~"
  prog "Services" null "systemctl-tui"
  prog "Antivirus Scan Directory" null "clamscandir"
  prog "Antivirus Scan File" null "clamscanfile"
  prog "Disk Boot Order" null "bootorder"
  prog "Open Ports" null "bash -c 'cli ports && pause'"
  prog "USB Images" null "xqdisks.sh"
  menu Tmux null {
	prog "Save pane to file" null "tmux-save-pane.sh"
  	prog "Copy buffer to clipboard" null "tmux-copy-pane.sh"
  }
  menu "Package Management" null {
    prog "Update System" null "sudo apt update"
    prog "Upgrade System" null "sudo apt upgrade"
    prog "Clean System" null "bash -c 'sudo apt autoremove && sudo apt autoclean && pause'"
  |
  menu "Dot Files" null {
    prog "Bash Aliases" null "micro ~/.bash_aliases"
    prog ".bashrc" null "micro ~/.bashrc"
    prog ".tmux.con" null "micro ~/.tmux.conf"
    prog ".dialogrc" null "micro ~/.dialogrc"
    prog ".nanorc" null "micro ~/.nanorc"
    prog ".dosbox" null "micro ~/.dosbox/dosbox-0.74-3.conf"
    prog "Geany conf." null "mc -c ~/.config/geany"
    prog "sources.list" null "sudo micro /etc/apt/sources.list"
    prog "rc.local" null "sudo micro /etc/rc.local"
    prog "hosts" null "sudo micro /etc/hosts"
    prog "grub" null "sudo micro /etc/default/grub"
    prog "mailcap - mimes" null "micro ~/.mailcap"
    prog "group" null "micro /etc/group"
    prog "logind.conf" null "micro /etc/systemd/logind.conf"
  }
}
menu Settings null {
  menu "Time and Date" null {
    prog "Set Date" null set_date.sh
    prog "Set Date from Internet" null set_date_auto.sh
    prog "Set Time" null set_time.sh
  }
}
menu Power null {
  prog Suspend null "systemctl suspend -i"
  prog Reboot null "systemctl reboot"
  prog "Lock Screen" null "xflock4"
  prog Shutdown null "systemctl poweroff"
}
